{
  "name": "bidwell-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/local.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build && tsx scripts/prune-css.ts",
    "preview": "vite preview --host 0.0.0.0",
    "start": "NODE_ENV=production tsx server/local.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "test:e2e": "node tests/user-journey.mjs",
    "prebuild": "tsx scripts/metadata.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/themes": "^3.3.0",
    "dotenv": "^18.0.9",
    "gsap": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "lighthouse": "^13.5.0",
    "purgecss": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
